{
  "id": "ferret_fight",
  "name": "FERRET FIGHT",
  "desc": "",
  "clear_desc": "",
  "replayable": true,
  "requires": [{ "cleared": "field_work" }],
  "game_events": [
    { "type": "dialog", "lines": [
      { "speaker": { "source": "enemy", "id": "ferret_samurai" }, "text": "This is <color:c8a135>our gate</color>, fox. Turn around, or bleed." },
      { "speaker": { "source": "class", "id": "samurai" }, "text": "Then I'll bleed on the way through." }
    ] },
    { "type": "battle", "battle_id": "ferrets_and_boars" },
    { "type": "if", "requires": ["battle_won"],
      "then": [
        { "type": "dialog", "lines": [
          { "speaker": { "source": "narrator" }, "text": "The ferrets lie quiet in the snow. The gate stands open." },
          { "speaker": { "source": "class", "id": "samurai" }, "text": "That wasn't so hard." }
        ] },
        { "type": "reward", "gold": 20 },
        { "type": "set_flag", "flag": "cleared:ferret_fight" },
        { "type": "exit" }
      ],
      "else": [
        { "type": "dialog", "lines": [
          { "speaker": { "source": "narrator" }, "text": "The ferrets drag you out of the snow and send you limping down the road." },
          { "speaker": { "source": "class", "id": "samurai" }, "text": "Next time." }
        ] },
        { "type": "exit" }
      ]
    }
  ]
}
